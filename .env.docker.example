APP_NAME="Peminjaman Alat"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Nama host DB pakai nama service di docker-compose.yml, BUKAN 127.0.0.1
DB_CONNECTION=mysql
DB_HOST=alat_db
DB_PORT=3306
DB_DATABASE=peminjaman_alat
DB_USERNAME=laravel
DB_PASSWORD=laravel

SESSION_DRIVER=file
SESSION_LIFETIME=120

FILESYSTEM_DISK=public

CACHE_STORE=file
QUEUE_CONNECTION=sync
